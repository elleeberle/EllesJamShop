{
  "name": "elles-jam-shop",
  "version": "1.0.0",
  "description": "Jam order form",
  "scripts": {
    "build": "esbuild app.jsx --bundle --outfile=dist/app.js --loader:.jsx=jsx",
    "dev": "esbuild app.jsx --bundle --outfile=dist/app.js --loader:.jsx=jsx --servedir=. --watch=forever --serve=3000 --banner:js=\"new EventSource('/esbuild').addEventListener('change', () => location.reload());\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "babel-jest": "^30.5.1",
    "esbuild": "^0.19.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
